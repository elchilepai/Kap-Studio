/** Compone los prompts TOP 3 (solo estructura, sin modelo) y genera el documento de revisión + un .txt por escena. npx tsx scripts/shorts-top3-prompts.mts [directorio] */
import fs from "node:fs/promises";
import path from "node:path";
const DIR = path.resolve(process.argv[2] ?? path.join(import.meta.dirname, "..", "docs", "shorts-v4-top3"));
const { composePrompt, promptIssues, STYLE_CARD, KAP_CARD, FORMAT_CARD, NEGATIVE_CARD } = await import("../src/narrative/top3Prompts");
const sb = JSON.parse(await fs.readFile(path.join(DIR, "storyboard.json"), "utf8")), pk = JSON.parse(await fs.readFile(path.join(DIR, "prompts.json"), "utf8"));
pk.estilo = STYLE_CARD; pk.kap = KAP_CARD; pk.formato = FORMAT_CARD; pk.negativo = NEGATIVE_CARD; const issues = promptIssues(pk);
await fs.mkdir(path.join(DIR, "prompts"), { recursive: true });
const L = ["# TOP 3 — prompts de imagen (9:16, imagen estática) para revisión", "", "*Prompts escritos para un generador externo con la referencia de KAP adjunta. No se ha generado ninguna imagen. Validación estructural sin modelo.*", "", "## 1. Ficha global de estilo (reutilizable)", "", STYLE_CARD, "", `**Formato:** ${FORMAT_CARD}`, "", `**Evitar siempre:** ${NEGATIVE_CARD}`, "", "## 2. Ficha de consistencia de KAP", "", KAP_CARD, "", "Constantes que no cambian entre escenas: cabeza blanca grande y redonda · ojos negros simples · cejas negras gruesas · aros dorados · sudadera negra oversized · cadena dorada gruesa con colgante de cerebro · pantalón negro ancho · zapatillas negras y blancas sin logos. Lo único que varía es la pose, la expresión (cejas, ojos y boca), la posición y la perspectiva. En escenas con KAP de espalda se ven la cabeza redonda, los aros, la sudadera y el pantalón.", "", "## 3. Escenas, prompts y movimiento en CapCut", ""];
let t = 0;
for (const [i, e] of sb.escenas.entries()) { const s = pk.escenas[i], prompt = composePrompt(s); await fs.writeFile(path.join(DIR, "prompts", `escena-${String(e.n).padStart(2, "0")}.txt`), prompt + "\n");
  L.push(`### Escena ${e.n} · ${e.bloque} · ${t.toFixed(1)}-${(t + e.duracion).toFixed(1)} s`, `- **Narración:** «${e.narracion}»`, `- **KAP:** ${s.kapPresente ? "aparece" : "no aparece"} · **Texto previsto:** ${s.texto.length ? s.texto.map((x: string) => `«${x}»`).join(" · ") : "(ninguno)"}`, `- **Movimiento CapCut:** ${s.capcut.movimiento} — ${s.capcut.detalle}`, "", "```", prompt, "```", ""); t += e.duracion; }
L.push("## 4. Notas de uso", "", "- Genera cada imagen con la referencia de KAP adjunta y el mismo generador/semilla de estilo para todas.", "- Si el generador deforma el texto (acentos, «¿», «€»), genera la imagen con las burbujas o pantallas vacías y añade el texto en CapCut; el texto previsto de cada escena está en la lista de arriba.", "- Deja libre el 12 % superior y el 20 % inferior para los subtítulos de CapCut.", "", "## Validación estructural (sin modelo)", "", issues.length ? issues.map((i: { msg: string }) => `- ${i.msg}`).join("\n") : "Sin avisos.");
await fs.writeFile(path.join(DIR, "PROMPTS-TOP3.md"), L.join("\n")); await fs.writeFile(path.join(DIR, "prompts.json"), JSON.stringify(pk, null, 1)); console.log(issues.length ? issues.map((i: { id: string; msg: string }) => i.id + ": " + i.msg).join("\n") : "SIN AVISOS", "| prompts:", pk.escenas.length);
