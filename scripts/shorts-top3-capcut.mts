/** Paquete para CapCut del TOP 3: fotogramas provisionales 1080x1920, subtítulos .srt, plan de montaje y prompts cortos. npx tsx scripts/shorts-top3-capcut.mts [directorio] */
import fs from "node:fs/promises";
import path from "node:path";
import { createRequire } from "node:module";
const DIR = path.resolve(process.argv[2] ?? path.join(import.meta.dirname, "..", "docs", "shorts-v4-top3")), OUT = path.join(DIR, "capcut");
const sb = JSON.parse(await fs.readFile(path.join(DIR, "storyboard.json"), "utf8")), pk = JSON.parse(await fs.readFile(path.join(DIR, "prompts.json"), "utf8")), sh = JSON.parse(await fs.readFile(path.join(DIR, "prompts-cortos.json"), "utf8"));
await fs.mkdir(path.join(OUT, "fotogramas"), { recursive: true });
const ts = (s: number) => { const ms = Math.round(s * 1000), h = Math.floor(ms / 3600000), m = Math.floor((ms % 3600000) / 60000), x = Math.floor((ms % 60000) / 1000); return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(x).padStart(2, "0")},${String(ms % 1000).padStart(3, "0")}`; };
// subtítulos: cada frase de la narración, repartida por palabras dentro de su escena
let t = 0, k = 1; const srt: string[] = [], plan: string[] = [], starts: number[] = [];
for (const e of sb.escenas) { starts.push(t); const sentences: string[] = e.narracion.match(/[^.?!]+[.?!]+/g)?.map((x: string) => x.trim()) ?? [e.narracion], parts: string[] = sentences.flatMap((x) => (x.split(/\s+/).length > 9 ? (x.match(/[^,]+,?/g) ?? [x]).map((y) => y.trim()).filter(Boolean) : [x])), words = parts.map((p) => p.split(/\s+/).length), total = words.reduce((a: number, b: number) => a + b, 0), speech = Math.min(e.duracion - 0.2, total / 2.6 + 0.4); let c = t + 0.1;
  parts.forEach((p, i) => { const d = (words[i] / total) * speech; srt.push(`${k++}\n${ts(c)} --> ${ts(c + d)}\n${p}\n`); c += d; }); t += e.duracion; }
await fs.writeFile(path.join(OUT, "subtitulos.srt"), srt.join("\n")); await fs.writeFile(path.join(OUT, "narracion.txt"), sb.escenas.map((e: { n: number; narracion: string }) => `[${e.n}] ${e.narracion}`).join("\n") + "\n");
t = 0; for (const [i, e] of sb.escenas.entries()) { const p = pk.escenas[i]; plan.push(`| ${e.n} | ${e.bloque} | ${t.toFixed(1)}–${(t + e.duracion).toFixed(1)} s | ${e.duracion} s | ${e.kap} | ${p.capcut.movimiento} | ${p.capcut.detalle.replace(/\|/g, "/")} |`); t += e.duracion; }
await fs.writeFile(path.join(OUT, "PLAN-CAPCUT.md"), ["# TOP 3 — plan de montaje en CapCut", "", `Formato 9:16 (1080×1920) · ${t.toFixed(1)} s · ${sb.escenas.length} escenas · música: ${sb.musica}`, "", "## Cómo usarlo", "", "1. Importa los 11 fotogramas de `fotogramas/` (`escena-01.png` … `escena-11.png`) en ese orden y ajusta cada clip a la duración de la tabla.", "2. Importa `subtitulos.srt` (Texto → Subtítulos → Importar) o pégalo por escenas; la locución completa está en `narracion.txt`.", "3. Cuando tengas las imágenes reales, sustituye cada fotograma con «Reemplazar clip» para conservar la duración, los subtítulos y el movimiento.", "4. Aplica el movimiento de la tabla con fotogramas clave (inicio y final del clip). Son solo zoom, desplazamiento, escala, parallax, partículas o luz.", "5. Deja libre el 12 % superior y el 20 % inferior para los subtítulos.", "", "## Línea de tiempo", "", "| # | Bloque | Tiempo | Duración | KAP | Movimiento | Detalle |", "|---|---|---|---|---|---|---|", ...plan, ""].join("\n"));
const KAP_SHORT = (n: boolean) => (n ? ` ${sh.kap}` : ""); const prompts = sh.escenas.map((s: { n: number; kap: boolean; texto: string }) => `${sh.estilo}${KAP_SHORT(s.kap)} ${s.texto} ${sh.formato}`);
await fs.writeFile(path.join(OUT, "PROMPTS-CORTOS.md"), ["# TOP 3 — prompts cortos (para generadores con límite de caracteres)", "", "Versión resumida (≈ 150 palabras) de los 11 prompts. Conserva KAP, composición, luz y texto. Adjunta siempre la referencia de KAP.", "", ...prompts.flatMap((p: string, i: number) => [`## Escena ${i + 1} (${p.split(/\s+/).length} palabras)`, "", "```", p, "```", ""])].join("\n"));
for (const [i, p] of prompts.entries()) await fs.writeFile(path.join(OUT, "fotogramas", `prompt-corto-${String(i + 1).padStart(2, "0")}.txt`), p + "\n");
// fotogramas provisionales
const { chromium } = createRequire(import.meta.url)("playwright"); const br = await chromium.launch(), page = await br.newPage({ viewport: { width: 1080, height: 1920 }, deviceScaleFactor: 1 });
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
for (const [i, e] of sb.escenas.entries()) { const p = pk.escenas[i];
  await page.setContent(`<html><body style="margin:0;width:1080px;height:1920px;background:${e.kap.startsWith("presentador") ? "#26303a" : e.kap.startsWith("no aparece") ? "#2b2f3a" : "#33302c"};color:#f2f2f2;font-family:Arial,Helvetica,sans-serif;display:flex;flex-direction:column;padding:150px 80px 330px;box-sizing:border-box"><div style="font-size:48px;opacity:.7;letter-spacing:4px">FOTOGRAMA PROVISIONAL · SUSTITUIR</div><div style="font-size:340px;font-weight:700;line-height:1.05;margin-top:40px">${e.n}</div><div style="font-size:64px;font-weight:700;color:#f3c64a">${esc(e.bloque)} · ${t && starts[i].toFixed(1)}–${(starts[i] + e.duracion).toFixed(1)} s</div><div style="font-size:50px;margin-top:20px">${esc(e.funcion)}</div><div style="font-size:42px;margin-top:40px;opacity:.85">KAP: ${esc(e.kap)}</div><div style="font-size:42px;margin-top:14px;opacity:.85">Texto: ${esc(e.texto || "(ninguno)")}</div><div style="font-size:42px;margin-top:14px;opacity:.85">Cámara: ${esc(p.capcut.movimiento)}</div><div style="margin-top:auto;font-size:46px;line-height:1.25;border-left:8px solid #f3c64a;padding-left:30px">«${esc(e.narracion)}»</div></body></html>`);
  await page.screenshot({ path: path.join(OUT, "fotogramas", `escena-${String(e.n).padStart(2, "0")}.png`) }); }
await br.close(); console.log("OK", sb.escenas.length, "fotogramas ·", srt.length, "subtítulos ·", prompts.map((p: string) => p.split(/\s+/).length).join("/"), "palabras");
