{
  "name": "kap-studio",
  "version": "0.1.0",
  "private": true,
  "description": "KAP Studio: estudio de producción audiovisual automatizado para el canal KAP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:create": "tsx --no-warnings scripts/admin.ts create",
    "admin:passwd": "tsx --no-warnings scripts/admin.ts passwd",
    "admin:list": "tsx --no-warnings scripts/admin.ts list",
    "admin:revoke": "tsx --no-warnings scripts/admin.ts revoke",
    "admin:unlock": "tsx --no-warnings scripts/admin.ts unlock",
    "check:access": "node scripts/check-access.mjs",
    "bench:episode": "tsx --no-warnings scripts/bench-episode.mts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.1.1",
    "busboy": "^1.6.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
