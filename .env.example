# Copia este archivo a .env.local (NO se sube a git). Ningún secreto va en el código.

# Directorio de datos: base SQLite, vídeos y temporales. En cloud, apunta a un volumen persistente.
KAP_DATA_DIR=./data
# Tamaño máximo por archivo subido (MB) y vida de los temporales (horas).
KAP_MAX_UPLOAD_MB=1024
KAP_TEMP_TTL_HOURS=24

# --- Fase B (autenticación): NO se guardan contraseñas en el entorno. ---
# El administrador se crea con un comando interactivo que guarda solo el hash (scrypt) en la base de datos.
# KAP_SESSION_SECRET=   (se generará con: openssl rand -base64 48)

# --- Integraciones opcionales (Fases F/G): ---
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
