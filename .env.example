# Copia este archivo a .env.local (NO se sube a git). Ningún secreto va en el código.

# Directorio de datos: base SQLite, vídeos y temporales. En cloud, apunta a un volumen persistente.
KAP_DATA_DIR=./data
# Tamaño máximo por archivo subido (MB) y vida de los temporales (horas).
KAP_MAX_UPLOAD_MB=1024
KAP_TEMP_TTL_HOURS=24

# --- Autenticación ---
# NO hay contraseñas ni secretos de sesión en el entorno: el administrador se crea con `npm run admin:create`
# y solo se guarda su hash (scrypt) en la base de datos. Ver docs/ADMIN.md.
# Cookie de sesión "Secure": por defecto activa en producción. Pon false SOLO para probar en local sin HTTPS.
# KAP_COOKIE_SECURE=false
# true únicamente detrás de un proxy/CDN de confianza que fije X-Forwarded-For (activa el límite de intentos por IP).
# KAP_TRUST_PROXY=false

# --- Integraciones opcionales (Fases F/G): ---
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=

# --- Motor de renderizado (Fase C): todo local con FFmpeg, sin servicios de pago ---
# KAP_FFMPEG_PATH=ffmpeg
# KAP_FFPROBE_PATH=ffprobe
# KAP_FONT_FILE=/usr/share/fonts/opentype/inter/Inter-Bold.otf   # si no se define se busca Inter / DejaVu
# KAP_RENDER_CONCURRENCY=1        # renders simultáneos (1-4). Con 4 CPU, 1 deja margen a la web.
# KAP_FFMPEG_THREADS=0            # 0 = automático
# KAP_RENDER_TIMEOUT_MIN=90       # tiempo máximo por trabajo
# KAP_RENDER_MAX_ATTEMPTS=2       # reintentos automáticos de fallos transitorios
# KAP_MIN_FREE_MB=1024            # espacio libre mínimo para empezar un render
# KAP_CLIP_WORKERS=1              # clips 2D animados a la vez (1-4). 1 = la menor memoria; 2 = ~16 % más rápido, +300 MB (ver docs/RENDIMIENTO.md)
# KAP_COMPOSE_MODE=segmentos      # montaje por tramos (poca memoria, caché por tramo) | unico (una sola pasada, la antigua)
# KAP_COMPOSE_SEGMENT=4           # escenas por tramo de montaje (1-12)
# KAP_CLIP_CACHE_MB=2048          # caché de clips por escena (se purga la más antigua)
# KAP_ESPEAK_PATH=espeak-ng       # voz local opcional (apt-get install espeak-ng)
# KAP_ANIM_WORKER=scripts/anim-worker.mjs   # trabajador de animación 2D (Node >= 22.18; usa @napi-rs/canvas, MIT)
